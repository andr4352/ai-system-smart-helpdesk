        Service -->|"Результат"| Repo["Репозиторий аудита"]
        Service -->|"JSON"| API
        API -.-> Obs["JSON-логи и metrics"]
    end
    API -->|"Ответ"| Client
    Repo --> DB[("SQLite")]
